{
  "name": "cameramini-cf",
  "version": "1.0.0",
  "description": "CameraMini.vn Fullstack Web Application on Cloudflare Workers & Cloudflare D1 Database",
  "main": "src/index.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:create": "wrangler d1 create cameramini_db",
    "d1:init": "wrangler d1 execute cameramini_db --file=./schema.sql"
  },
  "devDependencies": {
    "wrangler": "^3.100.0"
  }
}
